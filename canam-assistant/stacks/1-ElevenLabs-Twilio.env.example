# Stack 1: ElevenLabs + Twilio (default integrated stack)
# Copy to .env:  cp stacks/1-ElevenLabs-Twilio.env.example .env

STACK_NAME=ElevenLabs-Twilio
PORT=8080

TELEPHONY_PROVIDER=twilio
VOICE_AI_PROVIDER=elevenlabs

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVEN_LABS_COLD_CALLING_AGENT_ID=your_cold_calling_agent_id

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

NGROK_URL=
WEB_SERVER_URL=
NGROK_AUTHTOKEN=your_ngrok_authtoken

PROJECT_ID=your-gcp-project-id
REGION_NAME=us-central1
QUEUE_NAME=your-cloud-tasks-queue
BIG_QUERY_DATASET_ID=your_bigquery_dataset
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account_key.json

MAX_PARRALLEL_REQUESTS_TO_AGENT=20
DEFAULT_CALL_DURATION_IN_SECONDS=180
MAX_CALL_RETRY_COUNT=2
STATUS_COMPLETE_TASK_DELAY_IN_SECONDS=300
