# Stack 2: Plivo + Sarvam (custom stack)
# Copy to .env:  cp stacks/2-Plivo-Sarvam.env.example .env

STACK_NAME=Plivo-Sarvam
PORT=8080

# Telephony — Plivo
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_PHONE_NUMBER=+91XXXXXXXXXX

# Voice AI — Sarvam (STT + LLM + TTS)
VOICE_AI_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_PACE=0.95
SARVAM_TTS_PITCH=0.0
SARVAM_TTS_LOUDNESS=1.1
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SYSTEM_PROMPT_PATH=prompts/monica_cold_call.txt

# Optional: POST full call report (Q&A + recording URL) to your server when call ends
POST_CALL_WEBHOOK_URL=

# Public URL (ngrok for local webhook testing)
NGROK_URL=
WEB_SERVER_URL=
NGROK_AUTHTOKEN=your_ngrok_authtoken

# Google Cloud (Firestore, Pub/Sub, Tasks, BigQuery)
PROJECT_ID=your-gcp-project-id
REGION_NAME=us-central1
QUEUE_NAME=your-cloud-tasks-queue
BIG_QUERY_DATASET_ID=your_bigquery_dataset
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account_key.json

# Call tuning
MAX_PARRALLEL_REQUESTS_TO_AGENT=20
DEFAULT_CALL_DURATION_IN_SECONDS=180
MAX_CALL_RETRY_COUNT=2
STATUS_COMPLETE_TASK_DELAY_IN_SECONDS=300

# ElevenLabs not used on this stack (leave blank)
ELEVENLABS_API_KEY=
ELEVEN_LABS_COLD_CALLING_AGENT_ID=

# Twilio not used on this stack (leave blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
