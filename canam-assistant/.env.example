# =============================================================================
# Canam Assistant - Local Development Environment
# Copy to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Server ---
PORT=8080

# --- ElevenLabs (required for voice AI) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVEN_LABS_COLD_CALLING_AGENT_ID=your_cold_calling_agent_id
ELEVEN_LABS_AFTER_VISIT_FEEDBACK_AGENT_ID=

# --- Twilio (required for outbound/inbound calls) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- Public URL (required for Twilio webhooks when running locally) ---
# Set after starting ngrok — deploy.sh prints the URL automatically.
# Example: https://abc123.ngrok-free.app
NGROK_URL=
WEB_SERVER_URL=

# --- Google Cloud (required for Firestore, Pub/Sub, Tasks, BigQuery) ---
PROJECT_ID=your-gcp-project-id
REGION_NAME=us-central1
QUEUE_NAME=your-cloud-tasks-queue
BIG_QUERY_DATASET_ID=your_bigquery_dataset
GOOGLE_APPLICATION_CREDENTIALS=/app/service_account_key.json

# --- Call processing tuning ---
MAX_PARRALLEL_REQUESTS_TO_AGENT=20
DEFAULT_CALL_DURATION_IN_SECONDS=180
MAX_CALL_RETRY_COUNT=2
STATUS_COMPLETE_TASK_DELAY_IN_SECONDS=300

# --- Stack 1: ElevenLabs + Twilio ---
STACK_NAME=ElevenLabs-Twilio
TELEPHONY_PROVIDER=twilio
VOICE_AI_PROVIDER=elevenlabs

# --- Audio provider (legacy alias for TELEPHONY_PROVIDER) ---
AUDIO_PROVIDER=twilio

# --- Kommuno (only if AUDIO_PROVIDER=kommuno) ---
KOMMUNO_API_KEY=
KOMMUNO_AGENT_ID=
KOMMUNO_WEBSOCKET_URL=wss://api.kommuno.ai/v1/websocket
KOMMUNO_AUDIO_FORMAT=pcm
KOMMUNO_SAMPLE_RATE=8000
KOMMUNO_CHANNELS=1

# --- Ngrok (required for local Twilio webhook tunnel) ---
NGROK_AUTHTOKEN=your_ngrok_authtoken
